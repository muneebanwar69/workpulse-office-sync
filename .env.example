# Copy this file to `.env` next to sync.py and fill in the real values.
# `.env` is in .gitignore so your credentials never get committed.

# --- Auth changed with the Owesome SSO cutover -----------------------
# Login is now verified by the Owesome IdP; the returned token is sent to the
# HR sync API together with the workspace id.

# HR attendance/sync API (was hcm-api.owesome.work — that host is retired).
WORKPULSE_API=https://hr-api.owesome.work

# Owesome IdP — where email/password is verified and the access token is minted.
OWESOME_IDP_URL=https://api.owesome.work

# A service account that (a) is an Owesome identity, (b) is a member of the
# workspace below, and (c) has an HR role granting `devices:manage` or
# `attendance:create`. Its Owesome/HR password is used here.
WORKPULSE_EMAIL=sync-bot@ikonicsolution.com
WORKPULSE_PASSWORD=change_me

# The Owesome WORKSPACE UUID for this company (sent as X-Workspace-Id). The HR
# API uses it to resolve the tenant, role and permissions. Get it from the
# workspace URL / admin, e.g. 019f7f9e-3e46-73bd-aa5f-15783c501413
WORKPULSE_WORKSPACE_ID=

# ZKTeco K60 on the LAN
DEVICE_IP=192.168.101.247
DEVICE_PORT=4370

# How many days back to sync on each run.
#   0 = today only
#   1 = yesterday + today (recommended -- catches overnight 4PM-1AM shifts)
#   7 = week-long window (catch-up after downtime)
SYNC_WINDOW_DAYS=1
